#!/usr/bin/env bash
# generate_loop_diff — write per-file diffs of this repo's loop elaboration
# and loop specifications against the Lean toolchain's copies.
#
# Usage:
#   generate_loop_diff [--full] [toolchain]
#     --full    show the whole file (don't trim unchanged lines)
#     toolchain # elan dir name, e.g. leanprover--lean4-nightly---nightly-2026-08-22
#               # or a full path to a toolchain root; defaults to the active one
#
# Writes diffs/LoopElaboration.diff and diffs/Loop.diff.
set -euo pipefail

# Resolve the real location of this script (follow symlinks) so it works
# even when invoked through a symlink on $PATH.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO_ROOT="$(cd -P "$(dirname "$SOURCE")" && pwd)"
DIFF_DIR="$REPO_ROOT/diffs"

# Parse arguments: optional --full flag and/or a toolchain name/path.
FULL=0
TOOLCHAIN=""
for arg in "$@"; do
  case "$arg" in
    --full|-f) FULL=1;;
    *) TOOLCHAIN="$arg";;
  esac
done

# Resolve the toolchain root.
if [[ -z "$TOOLCHAIN" ]]; then
  LEAN_BIN="$(elan which lean 2>/dev/null)" || {
    echo "error: couldn't resolve active toolchain. Pass a toolchain name/path as an argument." >&2
    exit 1
  }
  TOOLCHAIN="$(cd "$(dirname "$LEAN_BIN")/.." && pwd)"
elif [[ ! -d "$TOOLCHAIN" ]]; then
  TOOLCHAIN="$HOME/.elan/toolchains/$TOOLCHAIN"
fi

[[ -d "$TOOLCHAIN" ]] || { echo "error: toolchain not found at $TOOLCHAIN" >&2; exit 1; }

mkdir -p "$DIFF_DIR"

if [[ $FULL -eq 1 ]]; then
  CONTEXT=100000   # effectively the whole file
else
  CONTEXT=3
fi

# Define mappings: toolchain relative path -> repo relative path -> output diff name
# Format: "toolchain_path|repo_path|out_diff_name"
MAPPINGS=(
  "src/lean/Lean/Elab/BuiltinDo/For.lean|Velvet/Elab/LoopElaboration.lean|LoopElaboration"
  "src/lean/Std/WP/Gadget/ForIn.lean|Velvet/Loop.lean|Loop"
)

for mapping in "${MAPPINGS[@]}"; do
  IFS='|' read -r tc_rel repo_rel out_name <<< "$mapping"
  src="$TOOLCHAIN/$tc_rel"
  dst="$REPO_ROOT/$repo_rel"

  [[ -f "$src" ]] || { echo "warning: missing $src" >&2; continue; }
  [[ -f "$dst" ]] || { echo "warning: missing $dst" >&2; continue; }

  out="$DIFF_DIR/$out_name.diff"
  rc=0
  diff -u -U "$CONTEXT" \
    --label "a/$tc_rel" \
    --label "b/$repo_rel" \
    "$src" "$dst" > "$out" || rc=$?

  case $rc in
    0) echo "wrote $out (no differences)";;
    1) echo "wrote $out ($(wc -l < "$out" | tr -d ' ') lines)";;
    *) echo "error: diff failed for $out_name (exit $rc)" >&2; rm -f "$out";;
  esac
done
